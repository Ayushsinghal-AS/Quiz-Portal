PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/quizarena
REDIS_URL=redis://127.0.0.1:6379
USE_IN_MEMORY_CACHE=false
JWT_SECRET=replace-with-a-secure-secret
COOKIE_SECRET=replace-with-a-cookie-secret
CLIENT_URL=http://localhost:5173
CROSS_SITE_COOKIES=false
LOG_LEVEL=info
SEED_ADMIN_NAME=QuizArena Admin
SEED_ADMIN_EMAIL=admin@quizarena.dev
SEED_ADMIN_PASSWORD=Admin123!
AUTH_SESSION_MAX_AGE_MS=604800000
BCRYPT_SALT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=8
