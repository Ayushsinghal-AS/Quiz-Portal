PORT=4000
# development | production | test
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/quizarena
REDIS_URL=redis://127.0.0.1:6379
# Set to true to skip Redis and cache in-process instead (useful when Redis
# isn't available, e.g. local smoke tests). Leave false in normal deployments.
USE_IN_MEMORY_CACHE=false
JWT_SECRET=replace-with-a-secure-secret
COOKIE_SECRET=replace-with-a-cookie-secret
CLIENT_URL=http://localhost:5173
# Set to true when the API and the web app are served from different origins
# (e.g. both tunneled through ngrok on separate subdomains). This switches the
# auth/csrf cookies to SameSite=None; Secure, which browsers require for
# cross-site cookies. Leave false for normal same-origin local development.
CROSS_SITE_COOKIES=false
LOG_LEVEL=info
SEED_ADMIN_NAME=QuizArena Admin
SEED_ADMIN_EMAIL=admin@quizarena.dev
SEED_ADMIN_PASSWORD=Admin123!
# How long a login session (auth cookie + JWT) stays valid, in milliseconds.
# 604800000 = 7 days.
AUTH_SESSION_MAX_AGE_MS=604800000
# bcrypt cost factor used when hashing passwords.
BCRYPT_SALT_ROUNDS=10
# Login/register rate limit: max requests per window, per IP.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=8
